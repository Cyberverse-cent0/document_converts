# API Configuration
VITE_API_URL=http://localhost:5280
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=Document Converter
VITE_APP_URL=http://localhost:5173

# File Upload Configuration
VITE_MAX_FILE_SIZE=52428800
VITE_MAX_FILES_PER_BATCH=10
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png

# Rate Limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# Feature Flags
VITE_ENABLE_DASHBOARD=true
VITE_ENABLE_HISTORY=true
VITE_ENABLE_SHARING=true
VITE_ENABLE_PREMIUM_FEATURES=true

# Storage Configuration
VITE_DEFAULT_STORAGE_LIMIT=104857600
VITE_STORAGE_WARNING_THRESHOLD=0.8

# Analytics (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ANALYTICS_ID=

# Debug Mode
VITE_DEBUG=false